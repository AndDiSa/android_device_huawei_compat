# ==========================================
# Huawei Specific Hardware & Binder Fixes
# ==========================================
allow system_server extra_input_device:chr_file { ioctl open read getattr write };

# Allow the system server to read Wi-Fi HAL properties
allow system_server wifi_hal_prop:file { getattr open read };

# Allow the system server to hand buffer references back to the Camera HAL
allow system_server hal_camera_default:binder transfer;
