# ==========================================
# hal_light_default.te - Notification LEDs
# ==========================================
# Allow the light HAL to write to sysfs nodes to toggle LEDs and brightness
allow hal_light_default sysfs_backlight:file rw_file_perms;

allow hal_light_default sysfs_led:dir r_dir_perms;
allow hal_light_default sysfs_led:file rw_file_perms;
allow hal_light_default sysfs_led:lnk_file read;

allow hal_light_default sysfs:dir r_dir_perms;
allow hal_light_default sysfs:file rw_file_perms;
allow hal_light_default sysfs:lnk_file read;

