type hal_touchscreen_default, domain;
hal_server_domain(hal_touchscreen_default, hal_touchscreen)

type hal_touchscreen_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_touchscreen_default)

# HwBinder IPC from client to server, and callbacks
binder_call(hal_touchscreen_client, hal_touchscreen_server)
binder_call(hal_touchscreen_server, hal_touchscreen_client)

hal_attribute_hwservice(hal_touchscreen, hal_touchscreen_hwservice)
