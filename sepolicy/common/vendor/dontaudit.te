# ==========================================
# Hardware Abstraction Layers (HALs)
# ==========================================
# Silence HALs trying to read core system properties (Treble boundary enforcement)
dontaudit { hal_camera_default hal_audio_default oeminfo_nvm hi110x_daemon hal_wifi_supplicant_default } default_prop:file r_file_perms;
dontaudit { hal_camera_default hal_audio_default hal_wifi_supplicant_default } config_prop:file r_file_perms;
dontaudit hal_fingerprint_default default_prop:file r_file_perms;

# ==========================================
# Google Play Services & Apps
# ==========================================
# Silence Play Services probing device state
dontaudit gmscore_app shell_prop:file { read open getattr };
dontaudit gmscore_app vendor_default_prop:file { read open getattr };
dontaudit gmscore_app vendor_hw_camera_prop:file { read open getattr };

# Silence untrusted and isolated apps probing hardware/system nodes
dontaudit untrusted_app_all block_device:dir search;
dontaudit untrusted_app_all proc:file { read open getattr };
dontaudit untrusted_app_all self:netlink_route_socket bind;
dontaudit untrusted_app_all vendor_default_prop:file { read open getattr };
dontaudit untrusted_app_all vendor_hw_camera_prop:file { read open getattr };
dontaudit untrusted_app block_device:dir search;
dontaudit untrusted_app proc_tty_drivers:file { read open getattr };
dontaudit untrusted_app qemu_hw_prop:file { read open getattr };
dontaudit untrusted_app serialno_prop:file { read open getattr };
dontaudit isolated_app app_data_file:file { setattr };
dontaudit isolated_app content_capture_service:service_manager find;
dontaudit priv_app device:dir { open read };

# ==========================================
# Core System Services
# ==========================================
# Silence generic shell access attempts
dontaudit shell domain:file { read getattr open };

# Silence system services reading raw vendor properties
dontaudit cameraserver vendor_default_prop:file r_file_perms;
dontaudit { surfaceflinger audioserver } vendor_default_prop:file r_file_perms;
dontaudit system_app vendor_wifi_prop:file r_file_perms;

# ==========================================
# Kernel, Init, and Low-Level Daemons
# ==========================================
dontaudit kernel device:chr_file { create setattr };
dontaudit kernel sysfs_batteryinfo:file r_file_perms;
dontaudit kernel sysfs:file { read open getattr };
dontaudit kernel system_data_file:file { setattr read append open getattr };
dontaudit kernel vendor_log_file:dir { search getattr setattr read open };
dontaudit init extra_input_device:chr_file { read open ioctl getattr };
dontaudit init sysfs:file { open write setattr read getattr };
dontaudit vendor_init default_prop:file { read open getattr };
dontaudit vendor_init init_service_status_prop:property_service set;
dontaudit vendor_init system_prop:file { read open getattr };
dontaudit vendor_hisi_init self:capability dac_override;
dontaudit bootanim system_data_file:dir search; 
dontaudit fsck_untrusted sysfs:file { read open getattr }; 
dontaudit network_stack fs_bpf:file { read write }; 
dontaudit oeminfo_nvm system_file:file { read getattr open };

