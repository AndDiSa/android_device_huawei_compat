cc_binary {
    name: "vendor.lineage.touch@1.0-service.huawei",
    init_rc: ["vendor.lineage.touch@1.0-service.huawei.rc"],
    vintf_fragments: ["vendor.lineage.touch@1.0-service.huawei.xml"],
    defaults: ["hidl_defaults"],
    relative_install_path: "hw",
    vendor: true,
    srcs: [
        "GloveMode.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "libhidlbase",
        "libutils",
        "vendor.lineage.touch@1.0",
    ],
}
